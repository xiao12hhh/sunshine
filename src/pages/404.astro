---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---
<MainGridLayout title="404" description="这个页面不存在">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-72">
		<div class="card-base z-10 relative w-full flex flex-col items-center justify-center text-center px-6 py-16">
			<div
				class="text-[5rem] leading-none font-extrabold tracking-tight tabular-nums onload-animation"
				style="color: oklch(0.72 0.14 var(--hue));"
			>
				404
			</div>
			<div class="mt-5 text-base text-neutral-700 dark:text-neutral-300">这个页面不存在，或者已经被挪走了。</div>
			<div class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">检查一下地址有没有拼错，或者从下面回去。</div>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href={url("/")} class="btn-regular rounded-lg h-10 px-5 text-sm text-neutral-900 dark:text-neutral-100">
					<Icon name="material-symbols:home-rounded" class="w-4 h-4 mr-1.5"></Icon>
					返回首页
				</a>
				<a href={url("/archive/")} class="btn-regular rounded-lg h-10 px-5 text-sm text-neutral-900 dark:text-neutral-100">
					<Icon name="material-symbols:archive-rounded" class="w-4 h-4 mr-1.5"></Icon>
					文章归档
				</a>
			</div>
		</div>
	</div>
</MainGridLayout>
