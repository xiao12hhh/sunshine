---
import { Icon } from "astro-icon/components";

interface SocialItem {
	name: string; // 平台名
	icon: string; // iconify 图标名
	url: string; // 完整跳转链接
	handle: string; // 展示的账号/短描述
	external?: boolean;
}

const socials: SocialItem[] = [
	{
		name: "GitHub",
		icon: "fa6-brands:github",
		url: "https://github.com/xiao12hhh",
		handle: "@xiao12hhh",
		external: true,
	},
	{
		name: "抖音",
		icon: "material-symbols:smart-display-rounded",
		url: "https://www.douyin.com/user/self",
		handle: "抖音主页",
		external: true,
	},
	{
		name: "B站",
		icon: "fa6-brands:bilibili",
		url: "https://space.bilibili.com/3546915180382330",
		handle: "UID 3546915180",
		external: true,
	},
	{
		name: "邮箱",
		icon: "fa6-solid:envelope",
		url: "mailto:3105461516@qq.com",
		handle: "3105461516@qq.com",
	},
	{
		name: "Steam",
		icon: "fa6-brands:steam",
		url: "https://steamcommunity.com/profiles/76561198769181178/",
		handle: "Steam 主页",
		external: true,
	},
];

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<div class:list={["card-base pb-4 pt-4 ", className]} style={style}>
	<div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-1 mb-2
        before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
        before:absolute before:left-[-16px] before:top-[5.5px]">
		找到我
	</div>
	<div class="px-4">
		{socials.map((s) => (
			<a
				href={s.url}
				target={s.external ? "_blank" : undefined}
				rel={s.external ? "noopener noreferrer" : undefined}
				class:list={[
					"group flex items-center gap-3 w-full h-10 rounded-lg px-3 my-0.5 transition-all",
					"hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]",
				]}
				title={s.handle}
			>
				<span
					class:list={[
						"w-8 h-8 shrink-0 rounded-lg flex items-center justify-center text-[1.05rem] transition",
						"bg-black/5 dark:bg-white/10 text-neutral-700 dark:text-neutral-200",
						"group-hover:text-[var(--primary)] dark:group-hover:text-[var(--primary)]",
					]}
				>
					<Icon name={s.icon}></Icon>
				</span>
				<span class="font-semibold text-sm text-neutral-800 dark:text-neutral-200 shrink-0">{s.name}</span>
				<span class="flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-right text-xs text-neutral-500 dark:text-neutral-400">
					{s.handle}
				</span>
				<Icon
					name="material-symbols:arrow-outward-rounded"
					class="text-[1rem] text-neutral-400 dark:text-neutral-500 shrink-0 transition group-hover:text-[var(--primary)]"
				></Icon>
			</a>
		))}
	</div>
</div>
